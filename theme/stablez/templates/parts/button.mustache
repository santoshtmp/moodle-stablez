{{!
    @template theme_stablez/parts/button

}}

<div class="stablez-button {{button_wrapper_class}}">
    <a href="{{button_link}}" class="{{button_class}}">
        <span class="label"> {{button_label}} </span>
        {{#icon_link}}
            <img src="{{icon_link}}" alt="icon">
        {{/icon_link}}
        {{#pix_svg_icon}}
            {{{pix_svg_icon}}}                
        {{/pix_svg_icon}}
    </a>
</div>
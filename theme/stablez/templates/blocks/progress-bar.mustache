{{!
    @template theme_stablez/blocks/progress-bar
}}


{{#is_enrolled}}
<div {{#block_stablez_id}}id="block-stablez-{{block_stablez_id}}" {{/block_stablez_id}}
    class="block-stablez-progress-bar">
    <div class="progress-bar-wrapper">
        <div class="my-enrolled-course">
            <p> {{#str}} course_progress, theme_stablez {{/str}} </p>
            <p class="progress-percentage"> {{course_percentage}}% {{#str}} complete, theme_stablez {{/str}} </p>
            <div class="progress">
                <div class="progress-bar bar" data-progress="{{course_percentage}}" aria-valuemin="0"
                    aria-valuemax="100" style="width: {{course_percentage}}%;">
                </div>
            </div>
        </div>
    </div>
</div>
{{/is_enrolled}}
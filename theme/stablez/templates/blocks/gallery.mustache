{{!
    @template theme_stablez/blocks/gallery
}}


<div {{#block_stablez_id}}id="block-stablez-{{block_stablez_id}}" {{/block_stablez_id}}
    class="block-stablez-gallery">
    {{#is_field_gallery}}
    <div class="gallery-collection">
        {{#field_gallery}}
        <div class="gallery-image image-1">
            <img src="{{url}}" alt="{{alt}}">
        </div>
        {{/field_gallery}}
    </div>
    {{/is_field_gallery}}
</div>

{{!
    @template local_stablezhelpers/content/view

    Template for displaying content view page.

    Example context (json):
    {
        "content": {
            "title": "Sample Content",
            "content": "<p>This is sample content.</p>",
            "contentformat": "1",
            "contenttype": "page",
            "status": "1",
            "id": "1"
        },
        "authorname": "John Doe",
        "contenttypelabel": "Page"
    }
}}

<div class="content-view-page">

    {{! Content image }}
    {{#content.image_url}}
    <div class="content-image">
       <img src="{{content.image_url}}">
    </div>
    {{/content.image_url}}
   
    {{! Content body }}
    <div class="content-body m-3">
        {{{content.content}}}
    </div>

</div>

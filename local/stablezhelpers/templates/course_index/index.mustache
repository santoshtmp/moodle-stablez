{{!
    @template local_stablezhelpers/course_index/index

    Course index container.

    The course index contains sections, activities and nested subsections.
    Sections and activities are rendered recursively while preserving the
    original Moodle course order.

    Example context (json):
    {
        "courseid": 2,
        "coursename": "Sample Course",
        "sections": [
            {
                "type": "section",
                "issection": true,
                "isactivity": false,
                "id": 10,
                "section": 1,
                "name": "Module 1",
                "url": "/course/section.php?id=10",
                "level": 0,
                "current": true,
                "restriction": {
                    "restricted": false,
                    "available": true,
                    "canaccess": true,
                    "showlock": false,
                    "info": ""
                },
                "children": []
            }
        ]
    }
}}

<div id="local-stablezhelpers-course-index" class="courseindex" data-courseid="{{courseid}}">
    <div class="courseindex-content">
        {{#sections}}
            {{> local_stablezhelpers/course_index/section }}
        {{/sections}}
    </div>
</div>
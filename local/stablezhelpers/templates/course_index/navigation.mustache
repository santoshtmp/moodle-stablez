    @template local_stablezhelpers/course_index/navigation

    Previous/next activity navigation.

    Example context (json):
    {
        "hasprevious": true,
        "hasnext": true,
        "previous": {
            "id": 10,
            "name": "Activity 1",
            "url": "/mod/page/view.php?id=10",
            "modname": "page",
            "icon": ""
        },
        "next": {
            "id": 11,
            "name": "Activity 2",
            "url": "/mod/page/view.php?id=11",
            "modname": "page",
            "icon": ""
        }
    }
}}

<nav class="course-index-navigation"
     role="navigation">

    {{#hasprevious}}
        <a class="course-index-navigation__previous"
           href="{{previous.url}}"
           aria-label="{{#str}}previous{{/str}}: {{previous.name}}">
            <div class="course-index-navigation__content">
                <span class="course-index-navigation__label">
                    {{#str}}previous{{/str}}
                </span>
            </div>
        </a>
    {{/hasprevious}}

    {{#hasnext}}
        <a class="course-index-navigation__next"
           href="{{next.url}}"
           aria-label="{{#str}}next{{/str}}: {{next.name}}">
            <div class="course-index-navigation__content">
                <span class="course-index-navigation__label">
                    {{#str}}next{{/str}}
                </span>
            </div>
        </a>
    {{/hasnext}}

</nav>
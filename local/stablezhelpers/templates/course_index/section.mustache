{{!
    @template local_stablezhelpers/course_index/section

    Course index section.

    A section can contain both activities and nested subsections.
    The children array must preserve Moodle's original course order.

    This template is recursive because a subsection is rendered using
    this same template.

    Example context (json):
    {
        "type": "section",
        "issection": true,
        "isactivity": false,
        "id": 10,
        "section": 1,
        "name": "Module 1",
        "url": "/course/section.php?id=10",
        "level": 0,
        "current": true,
        "haschildren": true,
        "restriction": {
            "restricted": false,
            "available": true,
            "canaccess": true,
            "showlock": false,
            "info": ""
        },
        "children": [
            {
                "type": "activity",
                "issection": false,
                "isactivity": true,
                "id": 101,
                "name": "Activity 1",
                "url": "/mod/page/view.php?id=101",
                "current": false,
                "completion": {
                    "enabled": true,
                    "state": 0,
                    "complete": false
                },
                "restriction": {
                    "restricted": false,
                    "available": true,
                    "canaccess": true,
                    "showlock": false,
                    "info": ""
                }
            },
            {
                "type": "section",
                "issection": true,
                "isactivity": false,
                "id": 11,
                "section": 2,
                "name": "Module 1.1",
                "url": "/course/section.php?id=11",
                "level": 1,
                "current": false,
                "restriction": {
                    "restricted": true,
                    "available": false,
                    "canaccess": false,
                    "showlock": true,
                    "info": "Complete Activity 1 first"
                },
                "children": []
            }
        ]
    }
}}

<div class="courseindex-section {{#current}}current{{/current}}"
     id="course-index-section-{{id}}"
     data-for="course_section"
     data-id="{{id}}"
     data-section="{{section}}"
     data-level="{{level}}">

    <div class="courseindex-section-title">
        <div class="courseindex-section-left">

            {{#restriction.canaccess}}

                <a
                    class="courseindex-link {{#current}}current{{/current}}"
                    href="{{url}}">

                    <span class="courseindex-section-name">
                        {{{name}}}
                    </span>

                </a>

            {{/restriction.canaccess}}


            {{^restriction.canaccess}}

                <span
                    class="courseindex-link courseindex-link-locked {{#current}}current{{/current}}"
                    aria-disabled="true">

                    <span class="courseindex-section-name">
                        {{{name}}}
                    </span>

                </span>

            {{/restriction.canaccess}}

        </div>


        {{#restriction.showlock}}
            <div class="courseindex-section-right">
                <span
                    class="courseindex-lock"
                    title="{{restriction.info}}"
                    aria-label="{{restriction.info}}">

                    {{#pix}}
                        t/locked,
                        core
                    {{/pix}}

                </span>
            </div>
        {{/restriction.showlock}}


    </div>

    {{#haschildren}}
        <div
            id="course-index-section-{{id}}-children"
            class="courseindex-section-content">

            {{#children}}

                {{#isactivity}}
                    {{> local_stablezhelpers/course_index/activity }}
                {{/isactivity}}

                {{#issection}}
                    {{> local_stablezhelpers/course_index/section }}
                {{/issection}}

            {{/children}}

        </div>

    {{/haschildren}}

</div>
{{!
    @template local_stablezhelpers/course_index/activity

    Course index activity or resource.

    Displays:
    - Activity icon.
    - Activity name.
    - Current activity state.
    - Completion state.
    - Availability restriction.
    - Lock state.

    Example context (json):
    {
        "type": "activity",
        "issection": false,
        "isactivity": true,
        "id": 101,
        "name": "Activity 1",
        "url": "/mod/page/view.php?id=101",
        "modname": "page",
        "icon": "/theme/image.php/core/page",
        "current": false,
        "visible": true,
        "uservisible": true,
        "completion": {
            "enabled": true,
            "state": 1,
            "complete": true
        },
        "restriction": {
            "restricted": false,
            "available": true,
            "canaccess": true,
            "showlock": false,
            "info": ""
        }
    }
}}

<div
    class="courseindex-item courseindex-item-activity {{#current}}current{{/current}} {{^restriction.canaccess}}dimmed{{/restriction.canaccess}}"
    data-for="cm"
    data-id="{{id}}"
    data-modname="{{modname}}">

    <div class="courseindex-item-content">

        {{#completion.enabled}}
            {{#completion.statuscomplete}}
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="8" cy="8" r="8" fill="#0B5E5F"/>
                <path d="M3.7002 8.01282L6.27222 10.5848L11.667 5.19002" stroke="white"/>
                </svg>
            {{/completion.statuscomplete}}

            {{#completion.statusincomplete}}
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <g opacity="0.3">
                <circle cx="8" cy="8" r="8" fill="#0B5E5F"/>
                <path d="M3.7002 8.01282L6.27222 10.5848L11.667 5.19002" stroke="white"/>
                </g>
                </svg>
            {{/completion.statusincomplete}}
        {{/completion.enabled}}

        {{#restriction.canaccess}}
            <a
                class="courseindex-link {{#current}}current{{/current}}"
                href="{{url}}">

                <span class="courseindex-link-name">
                    {{{name}}}
                </span>

            </a>

        {{/restriction.canaccess}}

        {{^restriction.canaccess}}
            <span
                class="courseindex-link courseindex-link-locked"
                aria-disabled="true">

                <span class="courseindex-link-name">
                    {{{name}}}
                </span>

            </span>

        {{/restriction.canaccess}}

        {{#restriction.showlock}}
            <span
                class="courseindex-lock"
                title="{{restriction.info}}"
                aria-label="{{restriction.info}}">
                {{#pix}}
                    t/locked,
                    core
                {{/pix}}
            </span>

        {{/restriction.showlock}}

    </div>

</div>